# PRODX Enterprise POS & Cloud Operations Environment Configuration
NODE_ENV=production
PORT=3000

# Automated PostgreSQL Connection & Migration Settings
DATABASE_URL=postgresql://prodx_admin:prodx_secure_pw@localhost:5432/prodx_pos
AUTO_MIGRATE_ON_BOOT=true
DB_POOL_MIN=4
DB_POOL_MAX=32

# Security, RBAC & Session Hardening
SESSION_SECRET=replace-with-64-byte-enterprise-hmac-secret
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECONDS=900
SUPERVISOR_PIN_REQUIRED_FOR_REFUND=true

# Real-Time Telemetry & Cloud CI/CD
PROMETHEUS_METRICS_ENABLED=true
CLOUD_DEPLOYMENT_REGION=asia-southeast1
